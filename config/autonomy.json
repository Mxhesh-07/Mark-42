{
  "enabled": true,
  "default_level": "confirm",
  "limits": {
    "max_actions_per_task": 8,
    "max_minutes_per_task": 10,
    "max_tasks_per_hour": 20
  },
  "tools": {
    "web_search": "allow",
    "weather_report": "allow",
    "youtube_video": "allow",
    "spotify_control": "allow",
    "reminder": "allow",
    "flight_finder": "allow",
    "open_app": "allow",
    "browser_control": "allow",
    "get_open_windows": "allow",
    "file_controller": "confirm",
    "computer_settings": "confirm",
    "computer_control": "confirm",
    "desktop_control": "confirm",
    "screen_process": "confirm",
    "send_message": "confirm",
    "cmd_control": "confirm",
    "code_helper": "confirm",
    "dev_agent": "confirm",
    "generated_code": "confirm",
    "devices": "confirm",
    "register_voice": "confirm",
    "smart_alert": "confirm",
    "notification": "confirm",
    "agent_task": "confirm",
    "business": "confirm",
    "enterprise": "confirm",
    "life": "confirm",
    "work_task": "confirm",
    "startup_task": "confirm",
    "hologram": "confirm"
  },
  "actions": {
    "file_controller": {
      "read": "allow",
      "list": "allow",
      "find": "allow",
      "disk_usage": "allow",
      "write": "allow",
      "create_file": "allow",
      "copy": "confirm",
      "move": "confirm",
      "delete": "confirm"
    },
    "computer_settings": {
      "shutdown": "block",
      "restart": "block",
      "lock": "confirm"
    },
    "devices": {
      "list": "allow",
      "info": "allow",
      "status": "allow",
      "notify": "allow",
      "screenshot": "allow",
      "ring": "allow",
      "media": "confirm",
      "lock": "confirm",
      "wol": "confirm",
      "exec": "confirm",
      "sms": "confirm",
      "call": "confirm",
      "shell": "block"
    }
  },
  "sandbox": {
    "enabled": true,
    "roots": ["~"]
  },
  "rate_limits": {
    "default": { "per_minute": 30, "burst": 12 },
    "global": { "per_minute": 120, "burst": 40 },
    "tools": {}
  },
  "egress": {
    "enabled": true,
    "block_private": true,
    "allow": [],
    "deny": [],
    "log_allowed": true
  },
  "privacy": {
    "log_redaction": "personal",
    "egress_redaction": "secrets"
  },
  "budget": {
    "enabled": true,
    "max_calls_per_hour": 60,
    "max_calls_per_day": 400,
    "on_breach": "read_only"
  },
  "roles": {
    "enforce": true,
    "enforce_on_unknown": false,
    "default": "owner",
    "map": { "owner": [], "guest": [] },
    "extra_tools": { "guest": [], "unknown": [] }
  },
  "initiative": {
    "enabled": true,
    "max_interrupts_per_hour": 3,
    "max_speaks_per_hour": 10,
    "min_urgency": 1,
    "quiet_hours": ["23:00", "07:00"],
    "triggers": {
      "battery_low": "speak",
      "long_focus_break": "digest"
    }
  }
}
