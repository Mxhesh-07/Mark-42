# Ignore Python cache and environment
__pycache__/
*.pyc
*.pyo
*.pyd
*.dll

# Ignore virtual environment
mediapipe_env/
genai_env/
venv/
env/

# Ignore secrets and credentials (never commit these)
config/api_keys.json
config/email_config.json
config/alert_config.json
config/spotify_config.json
.spotify_cache
.cache
.env
*.pem

# Ignore runtime data / user state
business_data.json
enterprise_data.json
work_data.json
life_data.json
notifications.json
alert_log.json
config/audio.json
voice_profiles.json
companion_experiences.json
companion_mood.json
startup_data.json
memory/long_term.json
memory/memories.json
memory/procedural_memory.json
memory/agent_tasks.json
memory/audit_log.jsonl
memory/AUTONOMY_OFF
*.json.tmp
config/hologram.pid
config/hologram_cmd.json
hologram_models/

# Ignore OS files
*.log
*.tmp
*.swp

# Ignore structured log output
logs/

# Ignore agent security/runtime state (A1 approval tokens, D1 database, ...)
memory/approval.key
memory/approval_used.json
memory/*.db
memory/*.db-journal
memory/*.db-wal
memory/*.db-shm
memory/backups/
memory/crashes/
memory/self.json
memory/metrics.json
config/approval_rules.json
memory/quota_ledger.json
recordings/
